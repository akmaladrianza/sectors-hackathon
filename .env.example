# Copy this file to .env and fill in your real key.
# .env is gitignored; never commit a real key.
SECTORS_API_KEY=your_sectors_api_key_here

# Optional: enables the "news-grounded suggestions (beta)" feature in Advanced mode.
# The Tavily search API is called directly via requests (no SDK package needed).
TAVILY_API_KEY=your_tavily_api_key_here
